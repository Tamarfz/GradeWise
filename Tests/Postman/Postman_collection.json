    {
      "name": "Authorization",
      "item": [
        {
          "name": "Try to request admin route while connected as a judge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Judge is blocked from an admin-only endpoint\", () => {\r",
                  "  pm.response.to.have.status(403);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response explains the permission failure\", () => {\r",
                  "  pm.expect(body.error).to.eql(\"Forbidden: Admin access required.\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{judgeToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/admin/current-admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "current-admin"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication API",
      "item": [
        {
          "name": "Validate admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns HTTP 200\", () => {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Token is valid\", () => {\r",
                  "  pm.expect(body.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token belongs to an admin\", () => {\r",
                  "  pm.expect(body.user.type).to.eql(\"admin\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token validation does not expose a password\", () => {\r",
                  "  pm.expect(body.user).not.to.have.property(\"password\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"token\": \"{{adminToken}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/check-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "check-token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Access an admin-only endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin can access the admin endpoint\", () => {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response does not expose a password hash\", () => {\r",
                  "  pm.expect(body).not.to.have.property(\"password\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Response belongs to an admin\", () => {\r",
                  "  pm.expect(body.type).to.eql(\"admin\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User type is Admin\", () => {\r",
                  "    pm.expect(body.type === \"admin\").to.be.true;\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/current-admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "current-admin"
              ]
            }
          },
          "response": []
