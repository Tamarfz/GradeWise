  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login as a judge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns HTTP 200\", () => {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Judge login succeeded\", () => {\r",
                  "  pm.expect(body.success).to.eql(true);\r",
                  "  pm.expect(body.user.type).to.eql(\"judge\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"A JWT token was returned\", () => {\r",
                  "  pm.expect(body.token).to.be.a(\"string\");\r",
                  "  pm.expect(body.token.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "if (body.success && body.token) {\r",
                  "  pm.environment.set(\"judgeToken\", body.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userID\": \"{{judgeId}}\",\r\n  \"password\": \"{{demoPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
